# Local prototype only. Generate fresh values; never commit .env files.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://solar:solar@localhost:5432/solar
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=
JWT_ALGORITHM=HS256
WEB3_PROVIDER_URL=http://localhost:8545
CHAIN_ID=31337
BACKEND_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATION_BLOCKS=2
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_QOS=1
MQTT_CLIENT_ID=solar-subscriber
# Addresses are registered per community through the authenticated API.
# Mail is optional for signup/login; password reset requires a configured mail worker.
MAIL_FROM=noreply@example.com
MAIL_SERVER=localhost

# Native worker defaults; contract addresses are populated by make demo.
COMMUNITY_REGISTRY_ADDRESS=
GOVERNANCE_TIMELOCK_ADDRESS=
NATIVE_SETTLEMENT_ENABLED=true
LEGACY_SETTLEMENT_ENABLED=false
NATIVE_SETTLEMENT_START_BLOCK=0
NATIVE_SETTLEMENT_LOOKBACK_HOURS=24
NATIVE_SETTLEMENT_INTERVAL_LIMIT=200
# Local setup generates missing seed values. Never commit actual values.
SEED_PASSWORD=
SEED_DEVICE_KEY=
# Ingest bounds and batch controls
MAX_METER_POWER_W=100000
MAX_TELEMETRY_BYTES=65536
QUEUE_MAXSIZE=10000
BATCH_SIZE=200
BATCH_FLUSH_SECONDS=1
