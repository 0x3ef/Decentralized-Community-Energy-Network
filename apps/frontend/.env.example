# Relative /api/v1 uses the Vite proxy in development and nginx in the prototype.
# For another origin include the complete versioned API prefix and configure CORS.
VITE_API_URL=/api/v1
# Supported chain IDs: Anvil 31337/1337 and Sepolia 11155111.
VITE_CHAIN_ID=31337
VITE_ANVIL_RPC_URL=http://127.0.0.1:8545
# Use a public deployment RPC URL without embedded private credentials.
VITE_SEPOLIA_RPC_URL=
# Registry returned for the selected community takes precedence over this fallback.
VITE_REGISTRY_ADDRESS=
# Must match the backend GOVERNANCE_TIMELOCK_ADDRESS for proposer preparation.
VITE_TIMELOCK_ADDRESS=
