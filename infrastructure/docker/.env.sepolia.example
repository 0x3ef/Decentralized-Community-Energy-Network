# Copy to an ignored .env.sepolia and configure through a secure environment.
# No public network deployment is possible with these empty placeholders.
ENVIRONMENT=testnet
CHAIN_ID=11155111
JWT_SECRET=
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
GOVERNANCE_PROPOSER_ADDRESS=
GOVERNANCE_EXECUTOR_ADDRESS=
ORACLE_ADDRESS=
# Backend signing key must correspond to ORACLE_ADDRESS, not the deployer.
BACKEND_PRIVATE_KEY=
COMMUNITY_REGISTRY_ADDRESS=
GOVERNANCE_TIMELOCK_ADDRESS=
BLOCKCHAIN_CONFIRMATION_BLOCKS=3
# Optional anonymous/public browser RPC; never copy a private provider credential here.
VITE_SEPOLIA_RPC_URL=

# Earliest confirmed deployment block from the public deployment journal.
NATIVE_SETTLEMENT_START_BLOCK=
