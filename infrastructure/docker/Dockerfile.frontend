# syntax=docker/dockerfile:1.7

# Build the static React application.
FROM node:24-alpine AS build

WORKDIR /app

COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --strict-ssl=true

COPY apps/frontend/src ./src
COPY apps/frontend/public ./public
COPY apps/frontend/index.html apps/frontend/tsconfig*.json apps/frontend/vite.config.ts ./
ARG VITE_API_URL=/api/v1
ARG VITE_CHAIN_ID=31337
ARG VITE_REGISTRY_ADDRESS=
ARG VITE_TIMELOCK_ADDRESS=
ARG VITE_SEPOLIA_RPC_URL=
ENV VITE_API_URL=${VITE_API_URL} VITE_CHAIN_ID=${VITE_CHAIN_ID} VITE_REGISTRY_ADDRESS=${VITE_REGISTRY_ADDRESS} VITE_TIMELOCK_ADDRESS=${VITE_TIMELOCK_ADDRESS} VITE_SEPOLIA_RPC_URL=${VITE_SEPOLIA_RPC_URL}

RUN npm run build

# Serve the compiled SPA with a small production web server.
FROM nginx:1.27-alpine AS runtime

COPY infrastructure/docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -Y off --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
