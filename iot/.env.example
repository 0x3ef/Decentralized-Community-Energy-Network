# Standalone simulator/gateway. Governed simulation uses direct v2 MQTT.
INTERVAL_SECONDS=15
ACCOUNTING_INTERVAL_SECONDS=900
RANDOM_SEED=
SEQUENCE_OFFSET=
USE_GRPC=false
PUBLISHER=mqtt
LOG_LEVEL=INFO

# Registered simulation: provision every enabled sensor and private env binding.
DEVICE_REGISTRY=
HOME_CATALOGUE_FILE=
HOME_PROFILES_JSON={}
CHECKPOINT_PATH=
SIMULATION_MODE=REALTIME
SIMULATION_SPEED=1
SIMULATION_START=
MAX_CYCLES=
FAULT_SCENARIO=none
FAULT_DEVICE=

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=solar-gateway
MQTT_QOS=1
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=

# Optional diagnostic v1 gRPC path
GATEWAY_ADDRESS=gateway:50051
GRPC_PORT=50051
GRPC_MAX_WORKERS=8
